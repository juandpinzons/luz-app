# Config para `npm run smoke:prod` -- SOLO producción, a propósito
# (docs/engineering/SMOKE_TEST_PLAN.md). El default sin sufijo, `npm
# run smoke`, usa `.env` (local) y nunca toca este archivo -- correr
# contra prod siempre requiere el comando explícito `smoke:prod`.
# Copia esto a `.env.smoke` (gitignored -- ver `.env*` en .gitignore).

# Connection string real de producción. Sacarlo de Neon
# (console.neon.tech), NO de Vercel: DATABASE_URL está marcado
# "Sensitive" ahí y no se puede revelar una vez marcado.
DATABASE_URL=

# Necesarios porque `core/config/env.ts` los exige, aunque los flujos
# de smoke test no llaman a OpenAI directo -- `sendMessageStream` sí,
# vía /api/chat. Usa cualquier key válida.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Fijo a producción a propósito -- este archivo existe para eso. No lo
# dejes vacío (el código por defecto apunta a localhost, no a esto).
SMOKE_BASE_URL=https://luz-app-joinluz.vercel.app
