# Config para `npm run smoke` (docs/engineering/SMOKE_TEST_PLAN.md).
# Copia a `.env.smoke` (gitignored -- ver `.env*` en .gitignore) y
# llena con el entorno real que quieras probar. Normalmente producción:
# el punto de un smoke test post-deploy es verificar prod de verdad,
# no una copia.

# Base de datos del entorno a probar -- producción normalmente.
# Sacar el connection string real de Neon (console.neon.tech), NO de
# Vercel: DATABASE_URL está marcado "Sensitive" ahí y no se puede
# revelar una vez marcado.
DATABASE_URL=

# Necesarios porque `core/config/env.ts` los exige, aunque los flujos
# de smoke test no llaman a OpenAI directo -- `sendMessageStream` sí,
# vía /api/chat. Usa cualquier key válida.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# URL de la app a probar. Default si se omite: el alias estable de
# producción (https://luz-app-joinluz.vercel.app). Cambialo para
# probar un preview deploy mientras desarrollas un flujo nuevo.
SMOKE_BASE_URL=
