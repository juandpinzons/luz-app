# Base de datos (PostgreSQL con extensión pgvector habilitada)
DATABASE_URL=postgres://luz:luz@localhost:5432/luz

# Proveedor de IA
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.1

# Kimi (Moonshot AI) -- segundo AIProvider, registrado y disponible por
# nombre (`getAIProvider("kimi")`), sin ningún consumidor real todavía.
# Opcional: la app arranca sin esto configurado. KIMI_MODEL/KIMI_BASE_URL
# ya traen default (kimi-k3 / https://api.moonshot.ai/v1) -- solo hace
# falta la key para que KimiProvider pueda instanciarse.
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Worker (Knowledge Engine)
WORKER_POLL_INTERVAL_MS=5000

# Cifrado de credenciales de terceros guardadas en texto reversible
# (hoy: la contraseña específica de app de Apple Calendar,
# core/calendar-connections/). 32 bytes en base64 -- genera una con:
#   openssl rand -base64 32
# Obligatoria: sin esto, conectar un calendario falla al arrancar la
# app (core/config/env.ts), nunca cae a texto plano en silencio.
CALENDAR_CREDENTIALS_ENCRYPTION_KEY=

# Cifrado de la SUSTANCIA del contenido -- memorias, creencias,
# insights, conceptos, contradicciones, conclusiones de razonamiento,
# mensajes de conversación, feedback, embeddings.content, tokens OAuth
# de Auth.js (core/security/content-cipher.ts, ADR-0024). DISTINTA de
# CALENDAR_CREDENTIALS_ENCRYPTION_KEY a propósito. 32 bytes en base64:
#   openssl rand -base64 32
# Obligatoria: sin esto, la app no arranca (core/config/env.ts).
# En producción vive SOLO en el entorno de runtime desplegado -- nunca
# en un .env local, ni siquiera el de un desarrollador de confianza
# (ADR-0024, Decisión 2).
CONTENT_ENCRYPTION_KEY=

# Identity Layer (auth/) — Auth.js las lee directamente de process.env,
# no pasan por core/config/env.ts (el dominio no conoce Auth.js).
# AUTH_SECRET es obligatorio en producción (NextAuth lanza error sin él).
AUTH_SECRET=
# Convención de Auth.js: AUTH_<PROVEEDOR>_ID / AUTH_<PROVEEDOR>_SECRET.
# Google es el primer proveedor (ver auth/providers); añadir otro es
# agregarlo a auth/providers/index.ts + sus credenciales aquí.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Observabilidad — emails con acceso a /admin, separados por coma.
# Vacío = /admin cerrado para todos.
ADMIN_EMAILS=

# Sentry (monitoreo de errores, 2026-08-06) — DSN del proyecto en
# sentry.io, visible del lado cliente a propósito (`NEXT_PUBLIC_`): un
# DSN no es secreto, es una clave de solo-escritura para reportar
# errores. Sin esto, el SDK queda inerte (no lanza, no reporta) — ver
# sentry.server.config.ts / sentry.edge.config.ts / instrumentation-client.ts.
NEXT_PUBLIC_SENTRY_DSN=
# Opcionales, solo para que el build suba sourcemaps legibles a Sentry
# (org/project en sentry.io, token en sentry.io/settings/account/api/auth-tokens/).
# Sin esto, Sentry sigue capturando errores, solo con stack traces minificados.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cron del Knowledge Engine (app/api/cron/knowledge-worker) — leído
# directo de process.env, mismo criterio que AUTH_SECRET arriba (glue
# de infraestructura, no config de dominio). Vercel Cron manda este
# valor como header `Authorization: Bearer <CRON_SECRET>` en cada
# invocación automáticamente una vez que la env var está configurada
# en el proyecto — no hace falta ponerlo a mano en ningún lado más.
# Sin este valor, la ruta rechaza cualquier request (401).
CRON_SECRET=
