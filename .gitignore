# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# artefacto de verificación de build (no debe commitearse)
/tmp/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example y .env.smoke.example SÍ se commitean, son plantillas sin secretos)
.env*
!.env.example
!.env.smoke.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.scratch/
